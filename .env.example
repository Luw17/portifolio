# URL do webhook n8n (ou endpoint de proxy como /api/contact)
# Deixe vazio para apenas registrar no console em ambiente local.
VITE_N8N_WEBHOOK_URL=

# Canais de contato exibidos no portfólio
VITE_CONTACT_EMAIL=seu-email@exemplo.com
VITE_CONTACT_GITHUB=https://github.com/seu-usuario
VITE_CONTACT_LINKEDIN=https://www.linkedin.com/in/seu-perfil/
# Digite seu número em qualquer formato (ex: +55 (12) 99125-1041 ou 12991251041)
# O site limpa os símbolos e gera automaticamente o link https://wa.me/...
VITE_CONTACT_WHATSAPP=5512999999999
# Opcional: mensagem pré-preenchida ao abrir a conversa no WhatsApp
VITE_CONTACT_WHATSAPP_MESSAGE=
